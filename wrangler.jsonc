{
  "$schema": "https://unpkg.com/wrangler@4.156.0/config-schema.json",
  "name": "odyssos",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [
    { "pattern": "odyssos.com", "custom_domain": true },
    { "pattern": "www.odyssos.com", "custom_domain": true },
  ],
}
